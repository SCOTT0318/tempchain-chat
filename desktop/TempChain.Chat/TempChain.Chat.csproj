<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TempChain.Chat</AssemblyName>
    <RootNamespace>TempChain.Chat</RootNamespace>
    <Version>1.3.0</Version>
    <Product>TChat</Product>
    <Title>TChat</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" Condition="Exists('Assets/app.ico')" />
    <Resource Include="Assets/TempChainLogo.png" Condition="Exists('Assets/TempChainLogo.png')" />
    <Resource Include="Assets/TempChainSymbol.png" Condition="Exists('Assets/TempChainSymbol.png')" />
  </ItemGroup>
</Project>
