<Window x:Class="TempChain.Chat.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TempChain Chat 설정" Width="600" Height="730" MinWidth="520" MinHeight="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18"><TextBlock Text="메신저 설정" FontSize="25" FontWeight="Bold"/><TextBlock Text="이 Windows 사용자에게만 적용됩니다." Foreground="{StaticResource MutedInk}" Margin="0,6,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,10,0">
      <Border Background="White" CornerRadius="16" Padding="20,14" Margin="0,0,0,14"><StackPanel><TextBlock Text="실행 환경" Foreground="#245C98" FontWeight="SemiBold"/><CheckBox x:Name="TrayCheckBox" Content="창을 닫으면 알림 영역에 계속 실행"/><CheckBox x:Name="StartupCheckBox" Content="Windows 로그인 시 자동 실행"/></StackPanel></Border>
      <Border Background="White" CornerRadius="16" Padding="20,14" Margin="0,0,0,14"><StackPanel><TextBlock Text="새 메시지 알림" Foreground="#245C98" FontWeight="SemiBold"/><CheckBox x:Name="NotificationsCheckBox" Content="다른 채팅방의 새 메시지도 알림 받기"/><CheckBox x:Name="AnimationCheckBox" Content="알림 나타남·사라짐 애니메이션"/><CheckBox x:Name="SoundCheckBox" Content="알림 소리 재생"/>
        <StackPanel Orientation="Horizontal" Margin="0,8"><Label Content="알림 표시 시간" Target="{Binding ElementName=DurationBox}" VerticalAlignment="Center"/><TextBox x:Name="DurationBox" Width="65" MaxLength="2" Padding="10,7" AutomationProperties.Name="알림 표시 시간 (초)"/><TextBlock Text="초 (1~60)" VerticalAlignment="Center" Margin="9,0,14,0"/><Button Content="알림 미리 보기" Click="PreviewNotification_Click"/></StackPanel>
        <TextBlock Text="앱이 실행 중일 때 약 3초 간격으로 확인합니다. 현재 보고 있는 방은 알림에서 제외하며 메시지 내용은 팝업에 표시하지 않습니다." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedInk}" LineHeight="19"/>
      </StackPanel></Border>
      <Border Background="White" CornerRadius="16" Padding="20,14"><StackPanel><TextBlock Text="바로가기 아이콘" Foreground="#245C98" FontWeight="SemiBold"/><WrapPanel Margin="0,14,0,12"><Button Content="바탕화면에 만들기" Click="DesktopShortcut_Click" Margin="0,0,8,8"/><Button Content="시작 메뉴에 만들기" Click="StartShortcut_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="현재 실행 중인 앱을 연결합니다. ZIP 버전은 폴더를 최종 위치에 옮긴 뒤 만드세요. 버튼을 누르면 즉시 생성됩니다." FontSize="11" Foreground="{StaticResource MutedInk}" TextWrapping="Wrap" LineHeight="19"/><TextBlock x:Name="ShortcutStatusText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#245C98" FontSize="12"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <TextBlock x:Name="ErrorText" Grid.Row="2" TextWrapping="Wrap" Foreground="#AD3E2A" Margin="0,10"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True" Padding="20,10"/><Button Content="저장" Style="{StaticResource PrimaryButton}" Padding="24,10" IsDefault="True" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
