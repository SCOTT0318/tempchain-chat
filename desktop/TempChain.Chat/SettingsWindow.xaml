<Window x:Class="TempChain.Chat.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TChat 설정" Width="660" Height="760" MinWidth="580" MinHeight="570" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource SoftGradient}" Padding="30,25" BorderBrush="#E0E9F2" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TChat 설정" FontSize="26" FontWeight="SemiBold"/></StackPanel><Border Grid.Column="1" Width="48" Height="48" CornerRadius="16" Background="White" VerticalAlignment="Center"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#237D91" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/></ScrollViewer.Resources><StackPanel Margin="28,22,28,12">
      <Border Background="White" BorderBrush="#E1E9F2" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,14"><StackPanel>
        <TextBlock Text="버전 및 업데이트" FontSize="15" FontWeight="SemiBold"/>
        <Grid Margin="0,15,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="현재 버전" Foreground="{StaticResource MutedInk}" FontSize="11"/><TextBlock x:Name="CurrentVersionText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="최신 버전" Foreground="{StaticResource MutedInk}" FontSize="11"/><TextBlock x:Name="LatestVersionText" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Grid>
        <CheckBox x:Name="AutoUpdateCheckBox" Content="자동 업데이트" ToolTip="시작 시와 6시간마다 확인·다운로드"/>

        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="#237D91" FontSize="12" Margin="0,0,0,12"/>
        <WrapPanel><Button x:Name="CheckUpdateButton" Content="업데이트 확인" Click="CheckUpdate_Click" Padding="14,9" Margin="0,0,8,6"/><Button x:Name="ApplyUpdateButton" Content="업데이트 및 재시작" Click="ApplyUpdate_Click" Style="{StaticResource PrimaryButton}" Padding="14,9" Margin="0,0,0,6"/></WrapPanel>
      </StackPanel></Border>
      <Border Background="White" BorderBrush="#E1E9F2" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,14"><StackPanel><TextBlock Text="실행 환경" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/><CheckBox x:Name="TrayCheckBox" Content="닫아도 계속 실행"/><CheckBox x:Name="StartupCheckBox" Content="Windows 시작 시 실행"/></StackPanel></Border>
      <Border Background="White" BorderBrush="#E1E9F2" BorderThickness="1" CornerRadius="16" Padding="22,18" Margin="0,0,0,14"><StackPanel>
        <Grid Margin="0,0,0,18"><TextBlock Text="새 메시지 알림" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="미리 보기" Click="PreviewNotification_Click" HorizontalAlignment="Right" Padding="12,7" FontSize="12" Margin="0"/></Grid>
        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="표시 시간" FontSize="13" FontWeight="SemiBold"/></StackPanel><ComboBox x:Name="DurationBox" Grid.Column="1" AutomationProperties.Name="알림 표시 시간"><ComboBoxItem Tag="3" Content="3초"/><ComboBoxItem Tag="4" Content="4초"/><ComboBoxItem Tag="5" Content="5초"/></ComboBox></Grid>
        <Border Height="1" Background="#EDF1F6" Margin="0,0,0,15"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="보낸 사람" FontSize="13" FontWeight="SemiBold"/></StackPanel><ComboBox x:Name="SenderBox" Grid.Column="1" AutomationProperties.Name="알림 보낸 사람 표시"><ComboBoxItem Content="보이기"/><ComboBoxItem Content="가리기"/></ComboBox></Grid>

      </StackPanel></Border>
      <Border Background="White" BorderBrush="#E1E9F2" BorderThickness="1" CornerRadius="16" Padding="22,18"><StackPanel><TextBlock Text="바로가기" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="바탕화면" FontWeight="SemiBold"/><TextBlock x:Name="DesktopShortcutStatus" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0"/></StackPanel><Button x:Name="DesktopShortcutButton" Content="추가" Grid.Column="1" Click="DesktopShortcut_Click" Padding="20,8" Margin="0" AutomationProperties.Name="바탕화면 바로가기 추가"/></Grid>
        <Border Height="1" Background="#EDF1F6" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="시작 메뉴" FontWeight="SemiBold"/><TextBlock x:Name="StartShortcutStatus" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,4,0,0"/></StackPanel><Button x:Name="StartShortcutButton" Content="추가" Grid.Column="1" Click="StartShortcut_Click" Padding="20,8" Margin="0" AutomationProperties.Name="시작 메뉴 바로가기 추가"/></Grid>
        <TextBlock x:Name="ShortcutStatusText" TextWrapping="Wrap" Foreground="#237D91" FontSize="12" Margin="0,10,0,0"/>
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="#E1E9F2" BorderThickness="0,1,0,0" Padding="28,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#AD3E2A" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="취소" IsCancel="True" Padding="20,10"/><Button Content="저장" Style="{StaticResource PrimaryButton}" Padding="24,10" IsDefault="True" Click="Save_Click"/></StackPanel></Grid></Border>
  </Grid>
</Window>
