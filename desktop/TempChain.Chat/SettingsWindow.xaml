<Window x:Class="TempChain.Chat.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TempChain Chat 설정" Width="550" Height="440" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="48" Height="48" CornerRadius="15" Background="{StaticResource SoftGradient}" VerticalAlignment="Top"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="#245C98" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="메신저 설정" FontSize="24" FontWeight="Bold"/><TextBlock Text="나의 업무 방식에 맞게, 더 편안하게." FontSize="12" Foreground="{StaticResource MutedInk}" Margin="0,7,0,0"/></StackPanel></Grid>
    <Border Grid.Row="1" CornerRadius="16" Background="White" BorderBrush="#E1E8F1" BorderThickness="1" Padding="21,14" Effect="{StaticResource CardShadow}"><StackPanel><TextBlock Text="실행 환경" FontSize="12" FontWeight="SemiBold" Foreground="#245C98" Margin="0,0,0,6"/><CheckBox x:Name="TrayCheckBox" Content="창을 닫으면 알림 영역에 계속 실행"/><Border Height="1" Background="#EDF1F6" Margin="0,5"/><CheckBox x:Name="StartupCheckBox" Content="Windows 로그인 시 자동 실행"/></StackPanel></Border>
    <StackPanel Grid.Row="2" Margin="2,15,0,0"><TextBlock Text="이 Windows 사용자에게만 적용됩니다." FontSize="11" Foreground="{StaticResource MutedInk}"/><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#AD3E2A" Margin="0,9,0,9"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="취소" IsCancel="True" Padding="20,10"/><Button Content="저장" Style="{StaticResource PrimaryButton}" Padding="24,10" IsDefault="True" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
