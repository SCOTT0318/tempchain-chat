<Window x:Class="TempChain.Chat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TempChain.Chat" Title="TChat" Width="1040" Height="740" MinWidth="800" MinHeight="600" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#E5F2F3" BorderBrush="#C5E2E5" BorderThickness="0,0,0,1" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="InstallUpdateButton" Content="업데이트 및 재시작" Style="{StaticResource PrimaryButton}" Padding="15,8" Click="InstallUpdate_Click"/></Grid></Border>
    <Grid x:Name="LoginView" Grid.Row="1" Background="#EEF2F5">
      <StackPanel Width="308" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <Image Source="Assets/TempChainLogo.png" Width="140" HorizontalAlignment="Center" Margin="0,0,0,30"/>
        <TextBlock Text="ERP 계정 로그인" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,28"/>
        <Label Content="ERP 계정" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,7" FontSize="12" Foreground="#506A84"/>
        <TextBox x:Name="UsernameBox" AutomationProperties.Name="ERP 계정" Height="42" Margin="0,0,0,16"/>
        <Label Content="비밀번호" Target="{Binding ElementName=LoginPasswordBox}" Padding="0,0,0,7" FontSize="12" Foreground="#506A84"/>
        <PasswordBox x:Name="LoginPasswordBox" AutomationProperties.Name="비밀번호" Height="42" Margin="0,0,0,12" KeyDown="LoginField_KeyDown"/>
        <TextBlock x:Name="LoginErrorText" Foreground="#B6473D" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"/>
        <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Height="42" Margin="0" Click="Login_Click"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="ChatView" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource RailGradient}"><Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" Width="43" Height="43" CornerRadius="12" VerticalAlignment="Center"><Image Source="Assets/TempChainSymbol.png" Margin="6" Stretch="Uniform"/></Border>
        <Button Grid.Row="1" ToolTip="대화 목록" AutomationProperties.Name="대화 목록" Click="Conversations_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=ConversationsList, Path=Visibility}" Value="Visible"><Setter Property="Background" Value="#315E87"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#517A9E"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="대화" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
        <Button Grid.Row="2" ToolTip="사내 연락처" AutomationProperties.Name="사내 연락처" Click="Contacts_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=ContactsList, Path=Visibility}" Value="Visible"><Setter Property="Background" Value="#315E87"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#517A9E"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="연락처" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
        <Button x:Name="LockRailButton" Grid.Row="4" Style="{StaticResource RailButton}" ToolTip="잠금 (Ctrl+L)" AutomationProperties.Name="잠금" Click="Lock_Click"><StackPanel><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="잠금" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button><Button x:Name="SettingsRailButton" Grid.Row="5" Style="{StaticResource RailButton}" Margin="7,5,7,20" ToolTip="설정 (Ctrl+,)" AutomationProperties.Name="설정" Click="Settings_Click"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="설정" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
      </Grid></Border>
      <Border Grid.Column="1" Background="#FCFDFE" BorderBrush="#E3EAF2" BorderThickness="0,0,1,0"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
        <Grid Margin="18,14"><TextBlock x:Name="DirectoryTitle" Text="대화" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="↻" HorizontalAlignment="Right" Padding="9,4" ToolTip="새로 고침 (Ctrl+R)" Click="Refresh_Click"/></Grid>
        <Grid Grid.Row="1" Margin="20,0,20,17"><TextBox x:Name="DirectorySearch" Padding="34,11,11,11" FontSize="12" AutomationProperties.Name="대화 또는 연락처 검색" ToolTip="이름 검색" TextChanged="DirectorySearch_TextChanged"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#6E8399" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="이름으로 검색" Foreground="#6E8399" FontSize="12" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=DirectorySearch, Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="2">
          <ListBox x:Name="ConversationsList" ItemsSource="{Binding Conversations}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DirectoryItem}" SelectionChanged="ConversationsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource SoftGradient}" Width="38" Height="38" CornerRadius="13" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Foreground="#174A7C" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#657B91" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ListBox x:Name="ContactsList" Visibility="Collapsed" ItemsSource="{Binding Contacts}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DirectoryItem}" SelectionChanged="ContactsList_SelectionChanged" MouseDoubleClick="ContactsList_MouseDoubleClick" KeyDown="ContactsList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E9F0E5" Width="35" Height="35" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Foreground="#679449" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" Foreground="#657B91" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock x:Name="DirectoryEmptyText" Text="대화 없음" Foreground="#657B91" FontSize="12" TextWrapping="Wrap" Margin="27,25" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#E3EAF2" BorderThickness="0,1,0,0"><Grid x:Name="MyAccountPanel" Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="16" Background="{StaticResource BrandGradient}" VerticalAlignment="Center"><TextBlock x:Name="MyInitialText" Text="T" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MyNameText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="내 계정" Foreground="#657B91" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button x:Name="AccountLogoutButton" Grid.Column="2" Content="로그아웃" Click="Logout_Click" AutomationProperties.Name="로그아웃" FontSize="11" Padding="8,8" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
      </Grid></Border>
      <Grid Grid.Column="2" Background="#E8EEF3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="ChatHeader" Visibility="Collapsed" Background="White" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1"><Grid Margin="20,8" MinHeight="47"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ChatTitleText" Text="대화" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ChatDetailText" Text="" Foreground="#657B91" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RoomActionsButton" Content="채팅방 관리 ▾" ToolTip="채팅방 관리" Click="RoomActions_Click"/><Button x:Name="HideConversationButton" Content="숨기기" ToolTip="숨기기" IsEnabled="False" Click="HideConversation_Click"/><Button x:Name="StartDirectButton" Content="대화 시작" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="StartDirect_Click"/></StackPanel></Grid></Border>
        <StackPanel Grid.Row="1"><Border x:Name="EncryptedNotice" Visibility="Collapsed" Background="#FFF6E8" Padding="22,10"><TextBlock Text="암호화 대화의 복호화·발신은 아직 지원하지 않습니다." Foreground="#9B6A29" FontSize="12" TextWrapping="Wrap"/></Border><Border x:Name="FileSelectionNotice" Visibility="Collapsed" Background="#FFF5E5" Padding="16,10"><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissFileNotice_Click" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Top" ToolTip="안내 닫기"/><ScrollViewer MaxHeight="88" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="FileSelectionError" TextWrapping="Wrap" FontSize="12" Foreground="#82551F"/></ScrollViewer></DockPanel></Border></StackPanel>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,18,27,12"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel MaxWidth="570">
            <TextBlock Text="{Binding Author}" Foreground="#7A8DA1" FontSize="11" Margin="3,0,3,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Border Padding="16,12" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="3,8,8,8"/><Setter Property="BorderBrush" Value="#E4EAF2"/><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Background" Value="#D7E9F7"/><Setter Property="CornerRadius" Value="8,3,8,8"/><Setter Property="BorderBrush" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="23"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2D425B"/><Style.Triggers><DataTrigger Binding="{Binding Text}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Foreground" Value="#173653"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Visibility="{Binding DownloadVisibility}" Tag="{Binding}" Click="DownloadFile_Click" Margin="0,6,0,0" Padding="10,8" HorizontalContentAlignment="Stretch" ToolTip="첨부파일 저장" AutomationProperties.Name="첨부파일 다운로드">
  <Grid MinWidth="180" MaxWidth="300"><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="4,0,10,0"><TextBlock Text="{Binding FileLabel}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" ToolTip="{Binding FileLabel}"/><TextBlock Text="{Binding FileDetail}" FontSize="10" Foreground="#6B7B8B" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/></Grid>
</Button></StackPanel></Border>
            <TextBlock Text="{Binding Time}" ToolTip="{Binding FullTime}" Foreground="#6C8095" FontSize="10" Margin="3,6,3,0" HorizontalAlignment="Right"/>
          </StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel x:Name="MessageEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" MaxWidth="340">
            <Border Width="72" Height="72" Background="#DCE6EF" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,22"><TextBlock x:Name="EmptyStateIcon" Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#7892A8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="EmptyHeadingText" Text="대화를 선택해 주세요" FontSize="18" FontWeight="SemiBold" Foreground="#415A6F" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyDetailText" Text="왼쪽 목록에서 대화를 선택하거나 연락처에서 새 대화를 시작하세요." Foreground="#75899A" FontSize="13" LineHeight="22" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <ProgressBar x:Name="EmptyLoadingBar" IsIndeterminate="True" Width="120" Height="3" Margin="0,22,0,0" Visibility="Collapsed"/>
            <Button x:Name="EmptyActionButton" Content="연락처 보기" Click="EmptyAction_Click" Style="{StaticResource PrimaryButton}" MinWidth="132" Height="38" Padding="18,0" Margin="0,24,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="3" x:Name="ComposerPanel" Visibility="Collapsed" Margin="0" CornerRadius="0" Padding="12,10">
          <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCE5EF"/><Setter Property="BorderThickness" Value="0,1,0,0"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#6C9CBD"/></Trigger></Style.Triggers></Style></Border.Style>
          <Border.Resources>
            <Style x:Key="ComposerAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
              <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="#F0F5FA"/><Setter Property="BorderBrush" Value="Transparent"/>
              <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E1EDF7"/></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="RemoveAttachment" TargetType="Button" BasedOn="{StaticResource ComposerAction}">
              <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#637A91"/>
            </Style>
          </Border.Resources>
          <StackPanel>
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding PendingFiles}" Margin="2,0,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Border Width="204" Background="#F4F7FB" BorderBrush="#E4EBF3" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,8,8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                      <Border Width="26" Height="30" Background="White" CornerRadius="6"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#3D759F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" VerticalAlignment="Center" FontSize="12" Foreground="#2D425B" TextTrimming="CharacterEllipsis" Margin="7,0,6,0"/>
                      <Button Grid.Column="2" Style="{StaticResource RemoveAttachment}" Tag="{Binding}" Click="RemoveFile_Click" ToolTip="첨부파일 제거" AutomationProperties.Name="첨부파일 제거" VerticalAlignment="Center"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="AttachButton" Style="{StaticResource ComposerAction}" VerticalAlignment="Bottom" Click="Attach_Click" IsEnabled="False" ToolTip="파일 첨부 · 여러 파일 선택 (파일당 10MB, 최대 20개)" AutomationProperties.Name="파일 첨부"><TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
              <Grid Grid.Column="1" Margin="10,0,10,0">
                <TextBox x:Name="MessageInput" Background="Transparent" BorderThickness="0" Padding="2,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="메시지 입력" PreviewKeyDown="MessageInput_PreviewKeyDown" IsEnabled="False"/>
                <TextBlock Text="메시지를 입력하세요" Foreground="#8495A7" FontSize="14" Margin="2,10,0,0" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=MessageInput}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Grid>
              <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="40" Padding="14,0" VerticalAlignment="Bottom" Margin="0" Click="Send_Click" IsEnabled="False" AutomationProperties.Name="메시지 보내기"><StackPanel Orientation="Horizontal"><TextBlock Text="보내기" VerticalAlignment="Center"/><TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="" FontSize="11" Foreground="#657B91" Margin="16,5,16,7" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </Grid>
    </Grid>
    <Border x:Name="LockOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Background="#EEF2F5">
      <Border.Resources>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
          <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#B1BFCA"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="PinLine" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PinLine" Property="BorderBrush" Value="#3774A4"/><Setter TargetName="PinLine" Property="BorderThickness" Value="0,0,0,2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
      </Border.Resources>
      <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Image x:Name="LockLogo" Source="Assets/TempChainLogo.png" Width="110" HorizontalAlignment="Center"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <StackPanel Width="308" Margin="0,24">
            <Border Width="76" Height="76" CornerRadius="20" Background="#D6E3ED" HorizontalAlignment="Center"><TextBlock x:Name="LockAccountInitial" Text="T" FontSize="30" Foreground="#4A6E8B" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock x:Name="LockAccountText" Text="TChat" TextAlignment="Center" FontSize="13" Foreground="#506779" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="LockStatusText" Text="잠금모드 상태입니다" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Margin="0,28,0,0"/>
            <TextBlock x:Name="LockHeading" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
            <StackPanel x:Name="LockModePanel" Margin="0,20,0,10"><UniformGrid Columns="3"><RadioButton x:Name="Pin4Option" Content="4자리" GroupName="LockMode" Checked="LockMode_Changed"/><RadioButton x:Name="Pin6Option" Content="6자리" GroupName="LockMode" Checked="LockMode_Changed"/><RadioButton x:Name="TextPasswordOption" Content="문자 암호" GroupName="LockMode" Checked="LockMode_Changed"/></UniformGrid></StackPanel>
            <TextBlock x:Name="LockPasswordLabel" Text="잠금 암호" Margin="0,12,0,8" FontSize="12"/>
            <Grid Margin="0,20,0,0"><local:PinInput x:Name="LockPinInput" KeyDown="LockPassword_KeyDown"/><PasswordBox x:Name="AppLockPasswordBox" MaxLength="128" Height="46" Padding="12" AutomationProperties.Name="앱 잠금 암호" KeyDown="LockPassword_KeyDown"/></Grid>
            <StackPanel x:Name="LockConfirmPanel" Margin="0,16,0,0"><TextBlock Text="암호 확인" Margin="0,0,0,8" FontSize="12"/><local:PinInput x:Name="LockPinConfirmInput" KeyDown="LockPassword_KeyDown"/><PasswordBox x:Name="AppLockConfirmBox" MaxLength="128" Height="46" Padding="12" AutomationProperties.Name="앱 잠금 암호 확인" KeyDown="LockPassword_KeyDown"/></StackPanel>
            <TextBlock x:Name="LockErrorText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#B04636" MinHeight="32" Margin="0,12,0,4" FontSize="12"/>
            <Button x:Name="LockSubmitButton" Content="잠금 해제" Style="{StaticResource PrimaryButton}" Click="Unlock_Click" Padding="15,12"/>
          </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="LockAutoHint" Grid.Row="2" Text="암호가 일치하면 자동으로 열립니다" FontSize="12" Foreground="#718292" TextAlignment="Center" Margin="0,16,0,8"/>
      </Grid>
    </Border>
  </Grid>
</Window>
