<Window x:Class="TempChain.Chat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TempChain.Chat" Title="TChat" Width="1180" Height="800" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#E5F2F3" BorderBrush="#C5E2E5" BorderThickness="0,0,0,1" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="InstallUpdateButton" Content="업데이트 및 재시작" Style="{StaticResource PrimaryButton}" Padding="15,8" Click="InstallUpdate_Click"/></Grid></Border>
    <Grid x:Name="LoginView" Grid.Row="1" Background="White">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SoftGradient}" ClipToBounds="True">
        <Grid>
          <Canvas IsHitTestVisible="False" Opacity="0.55"><Ellipse Width="460" Height="460" Stroke="#D3E3F6" StrokeThickness="1" Canvas.Left="-210" Canvas.Top="300"/><Ellipse Width="340" Height="340" Stroke="#D3E3F6" StrokeThickness="1" Canvas.Left="-150" Canvas.Top="360"/><Ellipse Width="250" Height="250" Fill="#DDEEEA" Canvas.Left="340" Canvas.Top="-110"/></Canvas>
          <Grid Margin="44,38">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Image Source="Assets/TempChainLogo.png" Width="210" HorizontalAlignment="Left" Stretch="Uniform"/>
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,25,0,25"><StackPanel Width="380">
              <TextBlock Text="TChat" FontSize="38" FontWeight="Bold" Foreground="#173F6A" LineHeight="51"/>
              <Grid MaxWidth="380" HorizontalAlignment="Left" Width="380" Height="155" IsHitTestVisible="False" AutomationProperties.Name="팀의 대화를 표현한 장식 일러스트">
                <Border Background="White" CornerRadius="16,16,16,4" Padding="18" Margin="0,0,45,57" Effect="{StaticResource CardShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" Background="#E6EFFB" CornerRadius="11" VerticalAlignment="Top"><Image Source="Assets/TempChainSymbol.png" Margin="6"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><Border Background="#DFE8F3" Height="7" CornerRadius="3" Width="130" HorizontalAlignment="Left"/><Border Background="#EDF2F8" Height="7" CornerRadius="3" Margin="0,10,0,0" Width="185" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
                <Border Background="{StaticResource BrandGradient}" CornerRadius="16,16,4,16" Padding="20,17" Margin="90,83,0,0" VerticalAlignment="Top" Effect="{StaticResource CardShadow}"><StackPanel><Border Background="#A9C8DF" Height="7" CornerRadius="3" Width="185" HorizontalAlignment="Left"/><Border Background="#79ADB9" Height="7" CornerRadius="3" Margin="0,10,0,0" Width="125" HorizontalAlignment="Left"/></StackPanel></Border>
              </Grid>
            </StackPanel></Viewbox>
          </Grid>
        </Grid>
      </Border>
      <Grid Grid.Column="1" Margin="42,32"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" MaxWidth="370" Margin="0,35">
          <Border Width="48" Height="48" CornerRadius="16" Background="{StaticResource SoftGradient}" HorizontalAlignment="Left" Margin="0,0,0,24"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="21" Foreground="#245C98" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="로그인" Margin="0,0,0,26" FontSize="31" FontWeight="Bold" Foreground="#173653"/>
          <Label Content="ERP 계정" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,8" Foreground="#506A84"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="ERP 계정" Margin="0,0,0,18"/>
          <Label Content="비밀번호" Target="{Binding ElementName=LoginPasswordBox}" Padding="0,0,0,8" Foreground="#506A84"/><PasswordBox x:Name="LoginPasswordBox" AutomationProperties.Name="비밀번호" Margin="0,0,0,18" KeyDown="LoginField_KeyDown"/>
          <TextBlock x:Name="LoginErrorText" Foreground="#B6473D" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="21"/>
          <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Padding="15,14" Margin="0" FontWeight="SemiBold" Click="Login_Click"/>
        </StackPanel></ScrollViewer>
      </Grid>
    </Grid>
    <Grid x:Name="ChatView" Grid.Row="1" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="298"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource RailGradient}"><Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" Width="43" Height="43" CornerRadius="12" VerticalAlignment="Center"><Image Source="Assets/TempChainSymbol.png" Margin="6" Stretch="Uniform"/></Border>
        <Button Grid.Row="1" ToolTip="대화 목록" AutomationProperties.Name="대화 목록" Click="Conversations_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=ConversationsList, Path=Visibility}" Value="Visible"><Setter Property="Background" Value="#315E87"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#517A9E"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="대화" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
        <Button Grid.Row="2" ToolTip="사내 연락처" AutomationProperties.Name="사내 연락처" Click="Contacts_Click"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource RailButton}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=ContactsList, Path=Visibility}" Value="Visible"><Setter Property="Background" Value="#315E87"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#517A9E"/></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center"/><TextBlock Text="연락처" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
        <Button x:Name="LockRailButton" Grid.Row="4" Style="{StaticResource RailButton}" ToolTip="잠금 (Ctrl+L)" AutomationProperties.Name="잠금" Click="Lock_Click"><StackPanel><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="잠금" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button><Button x:Name="SettingsRailButton" Grid.Row="5" Style="{StaticResource RailButton}" Margin="7,5,7,20" ToolTip="설정 (Ctrl+,)" AutomationProperties.Name="설정" Click="Settings_Click"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="19" HorizontalAlignment="Center"/><TextBlock Text="설정" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Button>
      </Grid></Border>
      <Border Grid.Column="1" Background="#FCFDFE" BorderBrush="#E3EAF2" BorderThickness="0,0,1,0"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="87"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="81"/></Grid.RowDefinitions>
        <Grid Margin="22,23"><TextBlock x:Name="DirectoryTitle" Text="대화" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="↻" HorizontalAlignment="Right" Padding="9,4" ToolTip="새로 고침 (Ctrl+R)" Click="Refresh_Click"/></Grid>
        <Grid Grid.Row="1" Margin="20,0,20,17"><TextBox x:Name="DirectorySearch" Padding="34,11,11,11" FontSize="12" AutomationProperties.Name="대화 또는 연락처 검색" ToolTip="이름 검색" TextChanged="DirectorySearch_TextChanged"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#6E8399" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="이름으로 검색" Foreground="#6E8399" FontSize="12" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=DirectorySearch, Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <Grid Grid.Row="2">
          <ListBox x:Name="ConversationsList" ItemsSource="{Binding Conversations}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DirectoryItem}" SelectionChanged="ConversationsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource SoftGradient}" Width="38" Height="38" CornerRadius="13" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Foreground="#174A7C" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#657B91" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ListBox x:Name="ContactsList" Visibility="Collapsed" ItemsSource="{Binding Contacts}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DirectoryItem}" MouseDoubleClick="ContactsList_MouseDoubleClick" KeyDown="ContactsList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E9F0E5" Width="35" Height="35" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Foreground="#679449" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}" Foreground="#657B91" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock x:Name="DirectoryEmptyText" Text="대화 없음" Foreground="#657B91" FontSize="12" TextWrapping="Wrap" Margin="27,25" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#E3EAF2" BorderThickness="0,1,0,0"><Grid x:Name="MyAccountPanel" Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="16" Background="{StaticResource BrandGradient}" VerticalAlignment="Center"><TextBlock x:Name="MyInitialText" Text="T" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MyNameText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="내 계정" Foreground="#657B91" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button x:Name="AccountLogoutButton" Grid.Column="2" Content="로그아웃" Click="Logout_Click" AutomationProperties.Name="로그아웃" FontSize="11" Padding="8,8" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></Border>
      </Grid></Border>
      <Grid Grid.Column="2" Background="#F6F8FC"><Grid.RowDefinitions><RowDefinition Height="87"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="29"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E8EDF3" BorderThickness="0,0,0,1"><Grid Margin="27,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ChatTitleText" Text="대화" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ChatDetailText" Text="" Foreground="#657B91" FontSize="12" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RoomActionsButton" Content="채팅방 관리 ▾" ToolTip="채팅방 관리" Click="RoomActions_Click"/><Button x:Name="HideConversationButton" Content="숨기기" ToolTip="숨기기" IsEnabled="False" Click="HideConversation_Click"/><Button x:Name="StartDirectButton" Content="대화 시작" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Click="StartDirect_Click"/></StackPanel></Grid></Border>
        <Border x:Name="EncryptedNotice" Grid.Row="1" Visibility="Collapsed" Background="#FFF6E8" Padding="22,10"><TextBlock Text="암호화 대화의 복호화·발신은 아직 지원하지 않습니다." Foreground="#9B6A29" FontSize="12" TextWrapping="Wrap"/></Border>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,18,27,12"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel MaxWidth="570">
            <TextBlock Text="{Binding Author}" Foreground="#7A8DA1" FontSize="11" Margin="3,0,3,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Border Padding="16,12" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="4,16,16,16"/><Setter Property="BorderBrush" Value="#E4EAF2"/><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Background" Value="{StaticResource BrandGradient}"/><Setter Property="CornerRadius" Value="16,4,16,16"/><Setter Property="BorderBrush" Value="Transparent"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="23"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2D425B"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="첨부파일" Visibility="{Binding AttachmentVisibility}" FontSize="11" Foreground="#839AB1" Margin="0,7,0,0"/></StackPanel></Border>
            <TextBlock Text="{Binding Time}" ToolTip="{Binding FullTime}" Foreground="#6C8095" FontSize="10" Margin="3,6,3,0" HorizontalAlignment="Right"/>
          </StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel x:Name="MessageEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"><Border Width="94" Height="94" Background="{StaticResource SoftGradient}" CornerRadius="32" Effect="{StaticResource CardShadow}" Margin="0,0,0,20"><Image Source="Assets/TempChainSymbol.png" Margin="24"/></Border><TextBlock x:Name="EmptyHeadingText" Text="" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDetailText" Text="" Foreground="#657B91" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
        </Grid>
        <Border Grid.Row="3" x:Name="ComposerPanel" Margin="25,10,25,10" Background="White" BorderBrush="#D8E3EF" BorderThickness="1" CornerRadius="18" Padding="9" Effect="{StaticResource CardShadow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MessageInput" Background="Transparent" BorderThickness="0" Padding="9,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="메시지 입력" PreviewKeyDown="MessageInput_PreviewKeyDown" IsEnabled="False"/><Button x:Name="SendButton" Grid.Column="1" Content="보내기" Style="{StaticResource PrimaryButton}" Padding="17,10" VerticalAlignment="Bottom" Margin="7,0,1,1" Click="Send_Click" IsEnabled="False"/></Grid></Border>
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="" FontSize="11" Foreground="#657B91" Margin="29,0,22,0" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Grid>
    <Border x:Name="LockOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Background="#F4F8FC">
      <Border.Resources>
        <Style TargetType="RadioButton">
          <Setter Property="Foreground" Value="#657B91"/><Setter Property="Cursor" Value="Hand"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="OptionBorder" Background="#F1F5F9" BorderBrush="#E1E9F2" BorderThickness="1" CornerRadius="9" Padding="8,11" Margin="0,0,6,0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#E5F2F3"/><Setter TargetName="OptionBorder" Property="BorderBrush" Value="#237D91"/><Setter Property="Foreground" Value="#176C7C"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </Border.Resources>
      <Border Background="White" CornerRadius="20" Padding="34" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#D8E3EF" BorderThickness="1">
        <StackPanel>
          <Image x:Name="LockLogo" Source="Assets/TempChainLogo.png" Width="180" HorizontalAlignment="Center" Margin="0,0,0,20"/>
          <TextBlock x:Name="LockHeading" FontSize="24" FontWeight="SemiBold"/>
          <StackPanel x:Name="LockModePanel" Margin="0,20,0,18"><TextBlock Text="암호 방식" Margin="0,0,0,10"/><UniformGrid Columns="3"><RadioButton x:Name="Pin4Option" Content="4자리로 하기" GroupName="LockMode" Checked="LockMode_Changed"/><RadioButton x:Name="Pin6Option" Content="6자리로 하기" GroupName="LockMode" Checked="LockMode_Changed"/><RadioButton x:Name="TextPasswordOption" Content="문자 포함" GroupName="LockMode" Checked="LockMode_Changed"/></UniformGrid></StackPanel><TextBlock x:Name="LockPasswordLabel" Text="잠금 암호" Margin="0,12,0,10"/>
          <Grid Margin="0,20,0,0"><local:PinInput x:Name="LockPinInput" KeyDown="LockPassword_KeyDown"/>
          <PasswordBox x:Name="AppLockPasswordBox" MaxLength="128" Padding="12" AutomationProperties.Name="앱 잠금 암호" KeyDown="LockPassword_KeyDown"/></Grid>
          <StackPanel x:Name="LockConfirmPanel" Margin="0,16,0,0"><TextBlock Text="암호 확인" Margin="0,0,0,7"/><local:PinInput x:Name="LockPinConfirmInput" KeyDown="LockPassword_KeyDown"/><PasswordBox x:Name="AppLockConfirmBox" MaxLength="128" Padding="12" AutomationProperties.Name="앱 잠금 암호 확인" KeyDown="LockPassword_KeyDown"/></StackPanel>
          <TextBlock x:Name="LockErrorText" TextWrapping="Wrap" Foreground="#AD3E2A" Margin="0,14,0,10"/>
          <Button x:Name="LockSubmitButton" Content="잠금 해제" Style="{StaticResource PrimaryButton}" Click="Unlock_Click" Padding="15,12"/>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
