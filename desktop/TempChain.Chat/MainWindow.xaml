<Window x:Class="TempChain.Chat.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TempChain Chat" Width="1180" Height="800" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid>
    <Grid x:Name="LoginView" Background="White">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#EDF4FC"><Grid Margin="52,46">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Image Source="Assets/TempChainLogo.png" Width="230" HorizontalAlignment="Left" Stretch="Uniform"/>
        <StackPanel Grid.Row="1" VerticalAlignment="Center"><Image Source="Assets/TempChainSymbol.png" Width="145" Height="145" Margin="0,0,0,34" HorizontalAlignment="Left"/><TextBlock Text="함께 일하는 대화,&#10;더 가까이." FontSize="39" FontWeight="SemiBold" Foreground="#174A7C" LineHeight="52"/><TextBlock Text="팀을 연결하는 TempChain Chat" FontSize="16" Foreground="#667D96" Margin="0,19,0,0"/></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#679449" VerticalAlignment="Center"/><TextBlock Text="사내 계정으로 연결되는 우리 팀의 공간" FontSize="12" Foreground="#667D96" Margin="9,0,0,0"/></StackPanel>
      </Grid></Border>
      <Grid Grid.Column="1" Margin="55,32"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center" MaxWidth="370" Margin="0,35">
          <TextBlock Text="반갑습니다" FontSize="30" FontWeight="SemiBold" Foreground="#173653"/>
          <TextBlock Text="사내 계정으로 로그인해 주세요." Foreground="#7890A5" Margin="0,10,0,30" FontSize="14"/>
          <Label Content="사용자 이름" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,8" Foreground="#506A84"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="사용자 이름" Margin="0,0,0,18"/>
          <Label Content="비밀번호" Target="{Binding ElementName=LoginPasswordBox}" Padding="0,0,0,8" Foreground="#506A84"/><PasswordBox x:Name="LoginPasswordBox" AutomationProperties.Name="비밀번호" Margin="0,0,0,18" KeyDown="LoginField_KeyDown"/>
          <Expander Header="2단계 인증 (선택)" Foreground="#667D96" Margin="0,0,0,20"><StackPanel Margin="0,14,0,0"><TextBlock Text="인증 코드 (설정된 계정만)" FontSize="12" Margin="0,0,0,7"/><TextBox x:Name="OtpBox" MaxLength="12" AutomationProperties.Name="2단계 인증 코드" Margin="0,0,0,8"/><TextBlock Text="비밀번호와 로그인 세션은 파일에 저장하지 않습니다." FontSize="11" Foreground="#8799AA" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Expander>
          <TextBlock x:Name="LoginErrorText" Foreground="#B6473D" TextWrapping="Wrap" Margin="0,0,0,14" LineHeight="21"/>
          <Button x:Name="LoginButton" Content="로그인" Background="#174A7C" Foreground="White" BorderBrush="#174A7C" Padding="15,13" Margin="0" FontWeight="SemiBold" Click="Login_Click"/>
        </StackPanel></ScrollViewer>
        <TextBlock Grid.Row="1" Text="TEMPCHAIN  ·  사내 전용 메신저" Foreground="#9AA9B7" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
      </Grid>
    </Grid>
    <Grid x:Name="ChatView" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="74"/><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#123A62"><Grid><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" Width="43" Height="43" CornerRadius="12" VerticalAlignment="Center"><Image Source="Assets/TempChainSymbol.png" Margin="6" Stretch="Uniform"/></Border>
        <Button Grid.Row="1" Style="{StaticResource RailButton}" Content="대화" ToolTip="대화 목록" Click="Conversations_Click"/><Button Grid.Row="2" Style="{StaticResource RailButton}" Content="연락처" ToolTip="사내 연락처" Click="Contacts_Click"/>
        <Button Grid.Row="4" Style="{StaticResource RailButton}" Content="설정" ToolTip="설정 (Ctrl+,)" Click="Settings_Click"/><Button Grid.Row="5" Style="{StaticResource RailButton}" Content="나가기" ToolTip="로그아웃" Margin="7,5,7,20" Click="Logout_Click"/>
      </Grid></Border>
      <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="#E3EAF2" BorderThickness="0,0,1,0"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="87"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="81"/></Grid.RowDefinitions>
        <Grid Margin="22,23"><TextBlock x:Name="DirectoryTitle" Text="대화" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="↻" HorizontalAlignment="Right" Padding="9,4" ToolTip="새로 고침 (Ctrl+R)" Click="Refresh_Click"/></Grid>
        <TextBox Grid.Row="1" x:Name="DirectorySearch" Margin="20,0,20,17" Padding="11,9" FontSize="12" AutomationProperties.Name="대화 또는 연락처 검색" ToolTip="이름 검색" TextChanged="DirectorySearch_TextChanged"/>
        <Grid Grid.Row="2">
          <ListBox x:Name="ConversationsList" ItemsSource="{Binding Conversations}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DirectoryItem}" SelectionChanged="ConversationsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E7EDF5" Width="35" Height="35" CornerRadius="11" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Foreground="#174A7C" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#8A9AAC" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <ListBox x:Name="ContactsList" Visibility="Collapsed" ItemsSource="{Binding Contacts}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DirectoryItem}" MouseDoubleClick="ContactsList_MouseDoubleClick" KeyDown="ContactsList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E9F0E5" Width="35" Height="35" CornerRadius="18" VerticalAlignment="Center"><TextBlock Text="{Binding Initial}" Foreground="#679449" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="#8A9AAC" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock x:Name="DirectoryEmptyText" Text="대화가 없습니다. 연락처에서 시작하세요." Foreground="#8A9AAC" FontSize="12" TextWrapping="Wrap" Margin="27,25" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
        <Border Grid.Row="3" BorderBrush="#E3EAF2" BorderThickness="0,1,0,0"><Grid Margin="22,15"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="16" Background="#174A7C" VerticalAlignment="Center"><TextBlock x:Name="MyInitialText" Text="T" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="MyNameText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="내 계정" Foreground="#8C9BAB" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></Border>
      </Grid></Border>
      <Grid Grid.Column="2" Background="White"><Grid.RowDefinitions><RowDefinition Height="87"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="29"/></Grid.RowDefinitions>
        <Border BorderBrush="#E8EDF3" BorderThickness="0,0,0,1"><Grid Margin="27,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ChatTitleText" Text="우리 팀과 대화를 시작해 보세요" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ChatDetailText" Text="왼쪽에서 대화를 선택하거나 연락처를 열어 주세요." Foreground="#8A9AAC" FontSize="12" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="HideConversationButton" Content="숨기기" ToolTip="메시지 삭제 없이 내 대화 목록에서 숨기기" IsEnabled="False" Click="HideConversation_Click"/><Button x:Name="StartDirectButton" Content="대화 시작" Visibility="Collapsed" Background="#174A7C" Foreground="White" Click="StartDirect_Click"/></StackPanel></Grid></Border>
        <Border x:Name="EncryptedNotice" Grid.Row="1" Visibility="Collapsed" Background="#FFF6E8" Padding="22,10"><TextBlock Text="암호화 대화의 복호화·발신은 아직 지원하지 않습니다." Foreground="#9B6A29" FontSize="12" TextWrapping="Wrap"/></Border>
        <Grid Grid.Row="2">
          <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="27,18,27,12"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.Style><Style TargetType="Grid"><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Grid.Style><StackPanel MaxWidth="570">
            <TextBlock Text="{Binding Author}" Foreground="#7A8DA1" FontSize="11" Margin="3,0,3,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Border CornerRadius="12" Padding="14,11"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#F0F3F8"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Background" Value="#174A7C"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="23"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#2D425B"/><Style.Triggers><DataTrigger Binding="{Binding IsOwn}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="첨부파일이 포함된 메시지입니다." Visibility="{Binding AttachmentVisibility}" FontSize="11" Foreground="#839AB1" Margin="0,7,0,0"/></StackPanel></Border>
            <TextBlock Text="{Binding Time}" ToolTip="{Binding FullTime}" Foreground="#A0ADBA" FontSize="10" Margin="3,6,3,0" HorizontalAlignment="Right"/>
          </StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
          <StackPanel x:Name="MessageEmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30"><Border Width="76" Height="76" Background="#F0F5FC" CornerRadius="25" Margin="0,0,0,20"><Image Source="Assets/TempChainSymbol.png" Margin="19"/></Border><TextBlock x:Name="EmptyHeadingText" Text="대화가 연결되는 곳" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDetailText" Text="연락처를 두 번 클릭하면 새 대화를 시작할 수 있습니다." Foreground="#8A9AAC" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
        </Grid>
        <Border Grid.Row="3" x:Name="ComposerPanel" Margin="25,10,25,10" Background="#F7F9FC" BorderBrush="#DDE6F0" BorderThickness="1" CornerRadius="13" Padding="7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MessageInput" Background="Transparent" BorderThickness="0" Padding="9,10" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" MaxHeight="140" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="메시지 입력" PreviewKeyDown="MessageInput_PreviewKeyDown" IsEnabled="False"/><Button x:Name="SendButton" Grid.Column="1" Content="보내기" Background="#174A7C" Foreground="White" BorderBrush="#174A7C" Padding="17,10" VerticalAlignment="Bottom" Margin="7,0,1,1" Click="Send_Click" IsEnabled="False"/></Grid></Border>
        <TextBlock Grid.Row="4" x:Name="StatusText" Text="대화를 불러오는 중" FontSize="11" Foreground="#8A9AAC" Margin="29,0,22,0" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
