<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the same production sources without loading WPF: core regression tests also run on Linux. -->
    <Compile Include="../TempChain.Chat/AppSettings.cs" Link="Production/AppSettings.cs" />
    <Compile Include="../TempChain.Chat/SettingsStore.cs" Link="Production/SettingsStore.cs" />
    <Compile Include="../TempChain.Chat/StartupRegistration.cs" Link="Production/StartupRegistration.cs" />
    <Compile Include="../TempChain.Chat/NavigationPolicy.cs" Link="Production/NavigationPolicy.cs" />
    <Compile Include="../TempChain.Chat/ServerConfiguration.cs" Link="Production/ServerConfiguration.cs" />
    <Compile Include="../TempChain.Chat/NotificationTracker.cs" Link="Production/NotificationTracker.cs" />
    <Compile Include="../TempChain.Chat/Models/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
    <Compile Include="../TempChain.Chat/Services/*.cs" Link="Production/Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
