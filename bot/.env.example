# DSM의 Synology Chat 실제 접속 주소. 사내 DNS 또는 NAS 주소를 입력합니다.
# 선택적 연동 API가 주소 등록 상태를 조회할 때 사용합니다. Windows 앱 설정과는 무관합니다.
SYNO_CHAT_URL=

# Chat > 프로필 사진 > 통합 > Incoming Webhook에서 복사한 전체 URL.
# URL의 token도 비밀정보입니다. .env를 저장소에 올리지 마세요.
SYNO_INCOMING_WEBHOOK_URL=

# Outgoing Webhook 또는 Slash Command에서 발급한 토큰.
SYNO_OUTGOING_TOKEN=

# 버튼 콜백용 Bot 토큰. 봇의 Outgoing URL은 /syno/outgoing으로 지정합니다.
# 한 Bot에서 일반 메시지와 버튼을 모두 쓰면 위 OUTGOING_TOKEN과 같은 Bot 토큰을 입력합니다.
# 이 엔드포인트는 요청 접수만 응답하며 승인·배포 작업을 수행하지 않습니다.
SYNO_ACTION_TOKEN=

# CI·모니터링이 /notify의 X-Notify-Token 헤더로 보낼 긴 임의의 비밀값.
# 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_TOKEN=

# NAS Incoming Webhook 응답 제한 시간(초, 0 초 초과 ~ 60 초).
WEBHOOK_TIMEOUT_SECONDS=10
